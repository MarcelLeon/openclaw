# Optional: preset channel plugin specs for automatic install.
# The installer loads install-cn-plugin-sources.env automatically if present.
#
# Example GitHub specs:
# QQ_PLUGIN_SPEC="github:your-org/openclaw-qq-plugin#main"
# DINGTALK_PLUGIN_SPEC="github:your-org/openclaw-dingtalk-plugin#main"
# FEISHU_PLUGIN_SPEC="github:your-org/openclaw-feishu-plugin#main"
